+    def _bind_pending(self):
+        with self._binding_condition:
+            requested = self._binding_requested
+        error = None
+        try:
+            self.do_start()
+        except BaseException as caught:
+            error = caught
+            raise
+        finally:
+            with self._binding_condition:
+                self._binding_completed = requested
+                self._binding_error = error
+                self._binding_condition.notify_all()
+
+    def wait_for_binding(self, time_out=10, cancel_check=None):
+        """等待最近一次异步绑定，避免准备与首帧操作旧输入对象。"""
+        deadline = time.monotonic() + time_out
+        while True:
+            if self.exit_event.is_set():
+                raise TaskDisabledException()
+            if cancel_check is not None:
+                if cancel_check():
+                    raise TaskDisabledException()
+            with self._binding_condition:
+                if self._binding_completed >= self._binding_requested:
+                    if self._binding_error is not None:
+                        raise RuntimeError('设备绑定失败') from self._binding_error
+                    return self.interaction
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError('等待设备绑定完成超时')
+                self._binding_condition.wait(min(0.05, remaining))
 
