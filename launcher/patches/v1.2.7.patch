+// 官方 setup 和当前工作树入口共用安装后半段，避免两套依赖参数和保存行为。
+pub(crate) async fn install_app_from_working(mut app: App, requested_profile: &str) -> Result<App, Error> {
+    let app_name = app.name.clone();
+    let working = get_app_working_dir_path(&app_name);
+    let config = crate::app::read_app_from_yml_strict(&working.join(YML_FILE_NAME))?;
+    let (profile, actual_profile) = get_profile_for_setup(&config, requested_profile, &app_name)?;
+    python_env::setup_python_env(app_name.clone(), &profile.requires_python).await?;
+    if !profile.requirements.is_empty() {
+        python_env::install_requirements(&app_name, &profile.requirements, &working, &profile.pip_args).await?;
+    }
+    app.icon = config.icon;
+    app.website = config.website;
+    app.profiles = config.profiles;
+    app.keep_releases = config.keep_releases;
+    app.current_profile = actual_profile;
+    app.installed = true;
+    save_app_config_to_json(&app).await?;
+    Ok(app)
 }
 
