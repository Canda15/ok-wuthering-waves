+    let mut app: App = serde_yaml::from_str(&content)
+        .map_err(|_| anyhow!("当前应用配置格式无效（E_APP_YAML_FORMAT）"))?;
+    apply_profile_inheritance(&mut app);
+    if app.profiles.is_empty() {
+        return Err(anyhow!("当前应用缺少运行配置（E_APP_PROFILE）"));
+    }
+    if !app.profiles.iter().any(|profile| profile.name == app.current_profile) {
+        app.current_profile = app.profiles[0].name.clone();
+    }
+    Ok(app)
 }
 
